{
  "expo": {
    "name": "PantryMacroMobile",
    "slug": "pantry-macro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Pantry Planner to scan food barcodes for instant nutritional analysis."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.opemiporoberts.pantrymacromobile"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pantry Planner to scan food barcodes."
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "9658a344-9019-43ee-88b7-bfea97114364"
      }
    }
  }
}
